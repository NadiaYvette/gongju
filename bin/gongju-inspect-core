#!/usr/bin/env bash
# bin/gongju-inspect-core — Zero-Cost GHC Core Inspection Verifier for gongju
#
# Mechanically verifies that GHC Core Simplifier under -O2 completely eliminates
# all typeclass dictionaries ($f..., $d..., C:...) from Gongju combinators,
# beta-reducing them into pure, direct lambda applications.
#
# Tested against:
# Note [Zero-Cost Inlining and Core Simplification] [ref:note-zero-cost-core-simplification]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

INSPECTION_SRC="${REPO_ROOT}/packages/gongju/test/CoreInspection.hs"
TMP_DIR="$(mktemp -d /tmp/gongju-core-inspect.XXXXXX)"
trap 'rm -rf "${TMP_DIR}"' EXIT

CORE_DUMP="${TMP_DIR}/CoreInspection.dump-simpl"

# Compile with -O2 and capture simplified Core
compile_inspection() {
  # Try cabal exec -- ghc first (resolves dist-newstyle package store in CI or isolated checkouts)
  if command -v cabal >/dev/null 2>&1; then
    if (cd "${REPO_ROOT}" && cabal exec -- ghc -O2 -ddump-simpl -dsuppress-all -dsuppress-uniques -fforce-recomp \
        -c "${INSPECTION_SRC}" \
        -dumpdir "${TMP_DIR}" \
        -outputdir "${TMP_DIR}" > "${CORE_DUMP}" 2>&1); then
      return 0
    fi
  fi

  # Fallback to direct GHC compiler in PATH or ghcup
  local ghc_bin=""
  if [[ -x "${HOME}/.ghcup/bin/ghc-9.14.1" ]]; then
    ghc_bin="${HOME}/.ghcup/bin/ghc-9.14.1"
  elif command -v ghc >/dev/null 2>&1; then
    ghc_bin="$(command -v ghc)"
  fi

  if [[ -n "${ghc_bin}" ]]; then
    if (cd "${REPO_ROOT}" && "${ghc_bin}" -O2 -ddump-simpl -dsuppress-all -dsuppress-uniques -fforce-recomp \
        -c "${INSPECTION_SRC}" \
        -dumpdir "${TMP_DIR}" \
        -outputdir "${TMP_DIR}" > "${CORE_DUMP}" 2>&1); then
      return 0
    fi
  fi

  echo "[-] ERROR: Failed to compile CoreInspection.hs under -O2:" >&2
  if [[ -f "${CORE_DUMP}" ]]; then
    cat "${CORE_DUMP}" >&2
  else
    echo "[-] No GHC compiler or cabal executable found in PATH." >&2
  fi
  exit 1
}

compile_inspection

# 1. Dictionary Check: Ensure NO Gongju typeclass dictionaries exist in Core
FORBIDDEN_DICTS=(
  "ComposeN"
  "Permute"
  "Yank"
  "Shove"
  "Twist"
  "PrecomposeAt"
  "SpliceAt"
  "ContramapN"
  "BindPos"
  "BindAfter"
  "LiftMask"
  "PermuteTuple"
  "YankTuple"
  "CurriedCat"
  "PermuteCat"
  "YankCat"
  "ComposeCatN"
)

for dict in "${FORBIDDEN_DICTS[@]}"; do
  if grep -E "(\\\$f|\\\$d|C:)${dict}" "${CORE_DUMP}" >/dev/null; then
    echo "[-] FAILURE: Found residual typeclass dictionary for '${dict}' in GHC Core:" >&2
    grep -E -C 3 "(\\\$f|\\\$d|C:)${dict}" "${CORE_DUMP}" >&2
    exit 1
  fi
done

# 2. Binding Check: Ensure all 22 test pipelines are present and defined without dictionary parameters
EXPECTED_BINDINGS=(
  "testComp2"
  "testComp3"
  "testSlipr1"
  "testSlipl2"
  "testTwist1"
  "testYank1"
  "testShove2"
  "testPermute3"
  "testPrecompose1"
  "testSplice12"
  "testBind1"
  "testBindPos11"
  "testLiftPure2"
  "testPermuteTuple3"
  "testPermuteInputs"
  "testSwapStrand"
  "testCatFlip"
  "testCatApply"
  "testCompCat2"
  "testYankCat1"
  "testPermuteCat3"
  "testPermuteHandler3"
)

verified_count=0
for binding in "${EXPECTED_BINDINGS[@]}"; do
  if ! grep -E -q "^${binding}([ =]|$)" "${CORE_DUMP}"; then
    echo "[-] FAILURE: Missing expected top-level binding '${binding}' in GHC Core dump." >&2
    exit 1
  fi
  # Verify that the binding does not accept any dictionary parameter ($d)
  if grep -A 3 -E "^${binding}([ =]|$)" "${CORE_DUMP}" | grep -q '\$d'; then
    echo "[-] FAILURE: Binding '${binding}' retains dictionary argument in GHC Core." >&2
    exit 1
  fi
  verified_count=$((verified_count + 1))
done

echo "0 residual dictionaries; ${verified_count}/${#EXPECTED_BINDINGS[@]} pipelines simplified to zero-overhead lambdas."
