#!/usr/bin/env bash
# bin/gongju-verify — Physical verification runner for gongju
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

verify_hlint() {
  echo "=== [1/6] HLint Static Analysis Gate ==="
  local hlint_cmd=""
  if [[ -x "${HOME}/.ghcup/bin/hlint" ]]; then
    hlint_cmd="${HOME}/.ghcup/bin/hlint"
  elif command -v hlint >/dev/null 2>&1; then
    hlint_cmd="$(command -v hlint)"
  fi

  if [[ -n "${hlint_cmd}" ]]; then
    "${hlint_cmd}" "${REPO_ROOT}"/packages/gongju*/src >/dev/null
    echo "  [+] Clean HLint run: 0 hints."
  else
    echo "  [SKIP] hlint binary not found."
  fi
}

verify_tests() {
  echo "=== [2/6] Full Cabal Test Suite ==="
  (cd "${REPO_ROOT}" && cabal test all >/dev/null)
  echo "  [+] All test suite assertions PASSED."
}

verify_core() {
  echo "=== [3/6] Zero-Cost GHC Core Inspection Gate ==="
  if [[ -x "${REPO_ROOT}/bin/gongju-inspect-core" ]]; then
    local core_out
    core_out="$("${REPO_ROOT}/bin/gongju-inspect-core")"
    echo "  [+] Zero-cost Core verified: ${core_out}"
  else
    echo "  [SKIP] bin/gongju-inspect-core not found or not executable."
  fi
}

verify_tagref() {
  echo "=== [4/6] Tagref Cross-Reference Gate ==="
  if [[ -x "${REPO_ROOT}/bin/gongju-tagref" ]]; then
    local tagref_out
    tagref_out="$("${REPO_ROOT}/bin/gongju-tagref")"
    echo "  [+] Tagref verified: ${tagref_out}"
  elif command -v tagref >/dev/null 2>&1; then
    (cd "${REPO_ROOT}" && tagref >/dev/null)
    echo "  [+] Tagref verified: 0 dangling references, 0 duplicate tags."
  else
    echo "  [SKIP] tagref binary not found."
  fi
}

verify_linkcheck() {
  echo "=== [5/6] Markdown Link & Anchor Integrity Gate ==="
  if [[ -x "${REPO_ROOT}/bin/gongju-linkcheck" ]]; then
    local linkcheck_out
    linkcheck_out="$("${REPO_ROOT}/bin/gongju-linkcheck" --quiet)"
    echo "  [+] Markdown links verified: ${linkcheck_out}"
  else
    echo "  [SKIP] bin/gongju-linkcheck not found or not executable."
  fi
}

verify_cloc() {
  echo "=== [6/6] CLOC Comment Density Gate ==="
  if [[ -x "${REPO_ROOT}/bin/gongju-cloc" ]]; then
    local cloc_out
    cloc_out="$("${REPO_ROOT}/bin/gongju-cloc" --quiet --check)"
    echo "  [+] Comment density verified: ${cloc_out}"
  else
    echo "  [SKIP] bin/gongju-cloc not found or not executable."
  fi
}

verify_hlint
verify_tests
verify_core
verify_tagref
verify_linkcheck
verify_cloc

echo "=== All 6 Physical Verification Checks PASSED ==="
